+    # --- Incremental-provider support (e.g. Deepgram Flux) -----------------
+    # supports_streaming providers are driven feed()/iter_audio() style: the
+    # dispatcher forwards LLM deltas to the streamer and a drain thread pulls
+    # PCM into per-turn sentence queues so the existing playback worker plays
+    # them in order. No sentence chopping, no idle wait.
+
+    def open_incremental(self) -> None:
+        """Open the streamer's long-lived session; raises on failure."""
+        self.streamer.open_session()
+
+    def feed(self, text_delta: str) -> None:
+        """Forward one LLM delta to the streamer."""
+        self.streamer.feed(text_delta)
+
+    def start_incremental_drain(self) -> None:
+        """Begin draining audio from the open session into a new sentence queue."""
+        self._prefetch_sem.acquire()
+        chunk_queue: "queue.Queue[Optional[bytes]]" = queue.Queue(maxsize=self._CHUNK_QUEUE_MAX)
+        self._audio_queue.put(chunk_queue)
+        self._prefetch_threads.append(threading.Thread(
+            target=self._consume_incremental, args=(chunk_queue,), daemon=True))
+        self._prefetch_threads[-1].start()
+
+    def _consume_incremental(self, chunk_queue: "queue.Queue[Optional[bytes]]") -> None:
+        try:
+            while not self.stop_event.is_set():
+                try:
+                    for chunk in self.streamer.iter_audio(timeout=0.02):
+                        chunk_queue.put(chunk, timeout=30.0)
+                except Exception as exc:
+                    logger.debug("streamer.iter_audio failed: %s", exc)
+                    break
+                session_done = bool(
+                    getattr(self.streamer, "_session_done", None) is not None
+                    and self.streamer._session_done.is_set()
+                )
+                if session_done:
+                    # Producer flushed + closed. Let the queue drain before the
+                    # sentinel so playback doesn't cut off the last frames.
+                    while not chunk_queue.empty() and not self.stop_event.is_set():
+                        threading.Event().wait(0.01)
+                    break
+        except Exception as exc:
+            logger.debug("incremental drain failed: %s", exc)
+        finally:
+            chunk_queue.put(None)  # sentinel
+            self._prefetch_sem.release()
+
+    def close_incremental(self) -> None:
+        """Flush and close the streamer's session, then wait for playback."""
+        try:
+            self.streamer.flush()
+        except Exception as exc:
+            logger.debug("streamer.flush failed: %s", exc)
+        # Wait up to 30s for the provider to finish synthesizing before
+        # closing — closing too early cuts off the last audio frames.
+        done = getattr(self.streamer, "_session_done", None)
+        if done is not None:
+            done.wait(timeout=30.0)
+        try:
+            self.streamer.close_session()
+        except Exception as exc:
+            logger.debug("streamer.close_session failed: %s", exc)
